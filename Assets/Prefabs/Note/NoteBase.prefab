  m_Script: {fileID: 11500000, guid: 8846c9d5dceb47948be398d60dee0681, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  text: "THEY'RE HERE. \nI locked the door, but it won't hold. Not for long. The
    scratching... it's getting louder. If you find this, GET OUT. Don't try to understand.
    Just run. The basement... \n\nI think there's another way. But be quick. They're
    hungry."
  uiText: {fileID: 2052690648386624773}
  noteUI: {fileID: 8192143635703023313}
