  m_Name: 
  m_EditorClassIdentifier: 
  textComponent: {fileID: 6016437202125432278}
  lines:
  - The flickering gas lamp cast long, dancing shadows across the cobblestones, each
    one a grotesque parody of a living thing.
  - Rain lashed against the grimy windows of the carriage, blurring the already dismal
    scene into an impressionistic nightmare.
  - Inside, you huddled deeper into your threadbare coat, the chill seeping into
    your bones despite the stifling humidity.
  textSpeed: 0.02
  mainSceneName: BuildLevel
